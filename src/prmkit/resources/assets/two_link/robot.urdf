<?xml version="1.0"?>
<robot name="two_link">
<link name="base"/>
<link name="arm1"><collision><origin xyz="0.175 0 0"/><geometry><box size="0.35 0.04 0.04"/></geometry></collision></link>
<link name="arm2"><collision><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.04 0.04"/></geometry></collision></link>
<link name="tool"/>
<joint name="shoulder" type="revolute"><parent link="base"/><child link="arm1"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="10" velocity="1"/></joint>
<joint name="elbow" type="revolute"><parent link="arm1"/><child link="arm2"/><origin xyz="0.35 0 0"/><axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="10" velocity="1"/></joint>
<joint name="tip" type="fixed"><parent link="arm2"/><child link="tool"/><origin xyz="0.30 0 0"/></joint>
</robot>